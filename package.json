{
  "name": "@chubbyts/chubbyts-framework-skeleton",
  "description": "A minimal skeleton for chubbyts-framework.",
  "type": "module",
  "keywords": [
    "chubbyts",
    "framework",
    "skeleton"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-framework-skeleton",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "command": "tsx bin/console.ts",
    "cs-fix": "prettier --write bin bootstrap config src tests *.ts",
    "cs": "prettier --check bin bootstrap config src tests *.ts",
    "develop:debug": "tsx watch --inspect=0.0.0.0:8888 bootstrap/index.ts",
    "develop": "tsx watch bootstrap/index.ts",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix bin bootstrap config src tests vitest.config.ts vitest.global-setup.ts vitest.integration.config.ts",
    "lint": "oxlint bin bootstrap config src tests vitest.config.ts vitest.global-setup.ts vitest.integration.config.ts",
    "start:debug": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm run develop:debug",
    "start": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm run develop",
    "test:integration": "vitest --config vitest.integration.config.js",
    "test": "vitest --config vitest.config.js"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-dic": "^2.4.1",
    "@chubbyts/chubbyts-dic-config": "^2.4.0",
    "@chubbyts/chubbyts-dic-types": "^2.4.0",
    "@chubbyts/chubbyts-framework": "^4.2.0",
    "@chubbyts/chubbyts-framework-router-path-to-regexp": "^4.1.1",
    "@chubbyts/chubbyts-http": "^3.1.0",
    "@chubbyts/chubbyts-http-error": "^3.6.0",
    "@chubbyts/chubbyts-http-node": "^1.1.2",
    "@chubbyts/chubbyts-http-types": "^4.2.2",
    "@chubbyts/chubbyts-log-types": "^3.4.0",
    "@chubbyts/chubbyts-pino-adapter": "^3.4.0",
    "commander": "^15.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-function-mock": "^2.4.0",
    "@chubbyts/chubbyts-oxlint": "^1.0.2",
    "@prettier/sync": "^0.6.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-fetch": "^4.1.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
